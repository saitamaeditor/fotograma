# Copia este archivo como .env y rellénalo. El .env nunca se sube al repositorio.

PORT=4000

# Clave para el panel de administración y los endpoints /api/admin (cabecera x-api-key).
# Pon una larga y aleatoria.
ADMIN_KEY=cambia-esto-por-una-clave-larga

# Orígenes que pueden llamar a la API desde el navegador (separados por comas). * = todos.
CORS_ORIGINS=*

# ---------- IDrive e2 (compatible con S3) ----------
# En el panel de IDrive e2: Buckets → crea un bucket; Access Keys → crea una clave.
# El endpoint aparece junto a la región, p. ej. https://s3.eu-central-2.idrivee2.com
E2_ENDPOINT=https://xxxx.idrivee2-xx.com
E2_REGION=eu-central-2
E2_BUCKET=fotograma
E2_ACCESS_KEY_ID=
E2_SECRET_ACCESS_KEY=

# Carpetas del bucket donde ya tienes tus vídeos, separadas por comas (vacío = todo el bucket).
# Ejemplo: E2_CARPETAS=Peliculas/,Series/
E2_CARPETAS=
# Carpeta donde se guardan los vídeos que subas desde el panel
E2_CARPETA_SUBIDAS=videos

# Minutos que dura un enlace firmado de reproducción
E2_URL_MINUTOS=240

# ---------- TMDB (metadatos, carteles, temporadas) ----------
# Clave v3 o token de lectura v4 de https://www.themoviedb.org/settings/api
TMDB_KEY=
TMDB_IDIOMA=es-ES
