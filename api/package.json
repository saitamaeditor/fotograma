{
  "name": "fotograma-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API de Fotograma: catálogo de películas y series con vídeos en IDrive e2",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "cors": "node --env-file-if-exists=.env scripts/configurar-cors.js",
    "probar-e2": "node --env-file-if-exists=.env scripts/probar-e2.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "compression": "^1.7.5",
    "express": "^4.21.2"
  }
}
