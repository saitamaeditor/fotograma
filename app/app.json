{
  "expo": {
    "name": "MorvehTV",
    "slug": "fotograma",
    "version": "1.14.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050507",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fotograma.app"
    },
    "android": {
      "package": "com.fotograma.app",
      "versionCode": 16,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0206"
      }
    },
    "plugins": [
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/android-tv",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050507",
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain"
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "apiUrl": "https://morvehtv.es",
      "eas": {
        "projectId": "da7a3b66-b265-4f37-ab95-657323d323b1"
      }
    },
    "owner": "morvehtv"
  }
}
